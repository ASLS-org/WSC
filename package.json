{
  "version": "1.0.0",
  "name": "@asls/wsc",
  "type": "module",
  "private": true,
  "description": "ASLS's WSC protocol (Web Show Control)",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "windows"
  ],
  "workspaces": [
    "./bindings/js/sdk",
    "./implementations/js/client",
    "./implementations/js/server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel",
    "dev:client": "npm run dev --workspace=@asls/wsc-client",
    "dev:server": "npm run dev --workspace=@asls/wsc-server",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --write .",
    "test": "npm run test --workspaces",
    "release:publish": "npm version $npm_package_version --workspaces --no-git-tag-version && npm publish --workspaces"
  },
  "author": "Timé Kadel",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "semantic-release": "^24.2.9",
    "tsx": "^4.21.0"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "staging",
        "prerelease": "rc"
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node scripts/sync-version.js ${nextRelease.version}",
          "publishCmd": "node scripts/publish.js"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
